 dtb-$(CONFIG_TARGET_EN7528) += \
diff --git a/arch/mips/dts/econet,en751221-tplink_xz000-g3-v1.dts b/arch/mips/dts/econet,en751221-tplink_xz000-g3-v1.dts
new file mode 100644
index 00000000..1292ee6f
--- /dev/null
+++ b/arch/mips/dts/econet,en751221-tplink_xz000-g3-v1.dts
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-2.0+
+/dts-v1/;
+
+#include "econet,en751221.dtsi"
+
+/ {
+	model = "TP-Link XZ000-G3 v1";
+	compatible = "tplink,xz000-g3-v1", "econet,en751221";
+
+	/* EN7521 with 64 MiB in-package DDR2, 16 MiB SPI-NOR, one GbE port. */
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	keys {
+		compatible = "gpio-keys-polled";
+
+		reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
+			debounce-interval = <60>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		pon_led: led@2 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+			function-enumerator = <2>;
+			gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
+		};
+
+		los_led: led@7 {
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_FAULT;
+			function-enumerator = <7>;
+			gpios = <&pinctrl 7 GPIO_ACTIVE_LOW>;
+		};
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&eth {
+	status = "okay";
+};
+
+&gdm1 {
+	status = "okay";
+};
+
+&switch0 {
+	status = "okay";
+};
+
+&spi0 {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+		spi-tx-bus-width = <1>;
+		spi-rx-bus-width = <2>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			/* Early boot stages, DRAMC and LZMA U-Boot */
+			partition@0 {
+				label = "u-boot";
+				reg = <0x000000 0x040000>;
+			};
+
+			/* Stock factoryinfo, in place: MAC at 0x0, EN7571 BOB at 0x16 */
+			partition@40000 {
+				label = "factory";
+				reg = <0x040000 0x010000>;
+				read-only;
+			};
+
+			/* Stock loid (GPON identity), in place */
+			partition@50000 {
+				label = "loid";
+				reg = <0x050000 0x010000>;
+				read-only;
+			};
+
+			/* Stock hwinfo, in place */
+			partition@60000 {
+				label = "hwinfo";
+				reg = <0x060000 0x010000>;
+				read-only;
+			};
+
+			/* Stock config/iot/kernelA/rootfsA/kernelB/rootfsB/other */
+			partition@70000 {
+				label = "firmware";
+				reg = <0x070000 0xf90000>;
+			};
+		};
+	};
+};
