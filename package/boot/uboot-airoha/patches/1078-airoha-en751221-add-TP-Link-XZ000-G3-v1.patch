 .../econet,en751221-tplink_xz000-g3-v1.dts    | 111 ++++++++++++++++++
 configs/en751221_tplink_xz000-g3-v1_defconfig |  72 ++++++++++++
 defenvs/en751221_tplink_xz000-g3-v1           |  62 ++++++++++
 4 files changed, 246 insertions(+)
