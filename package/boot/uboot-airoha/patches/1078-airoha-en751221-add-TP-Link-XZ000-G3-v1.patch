diff --git a/defenvs/en751221_tplink_xz000-g3-v1 b/defenvs/en751221_tplink_xz000-g3-v1
new file mode 100644
index 00000000..bd3b234a
--- /dev/null
+++ b/defenvs/en751221_tplink_xz000-g3-v1
@@ -0,0 +1,62 @@
+loadaddr=0x82000000
+ipaddr=192.168.1.1
+serverip=192.168.1.10
+bootled=green:status-2
+
+bootconf=config-1
+bootfile=openwrt-airoha-en751221_tiny-tplink_xz000-g3-v1-initramfs-kernel.bin
+sysupgradefile=openwrt-airoha-en751221_tiny-tplink_xz000-g3-v1-squashfs-sysupgrade.bin
+bootloaderfile=openwrt-airoha-en751221_tiny-tplink_xz000-g3-v1-bootloader.bin
+
+set_ethaddr=setenv ethaddr; mtd read factory 0x81f00000 0 0x100 && bin2mac ethaddr 0x81f00000 6
+
+boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
+# Read only the FIT (its totalsize, bounded by the firmware partition),
+# not the squashfs behind it.
+flash_read_openwrt=\
+  mtd read firmware $loadaddr 0 0x1000 && itest.l *$loadaddr == 0xd00dfeed && \
+  setexpr.l fitsize *0x82000004 && itest $fitsize <= f90000 && \
+  mtd read firmware $loadaddr 0 $fitsize && iminfo $loadaddr
+boot_openwrt=led $bootled blink 250; if run flash_read_openwrt; then bootm $loadaddr#$bootconf; fi; echo Install OpenWrt over TFTP; led $bootled on; run boot_tftp
+
+# Only the FIT part of the sysupgrade image carries hashes; the size check
+# keeps an oversized file from erasing a working installation.
+install_openwrt=\
+  tftpboot $loadaddr $sysupgradefile && itest $filesize <= f90000 && \
+  iminfo $loadaddr && \
+  mtd erase firmware && mtd write firmware $loadaddr 0 $filesize
+
+# The bootloader image is the 256 KiB airoha_mips_dramc image: the "6578"
+# tcboot magic, the complemented CRC32 of 0x0-0x1fffc at 0x1fffc, and an
+# LZMA U-Boot uImage for 0x81000000 at 0x20000. Everything is checked
+# before the boot area is erased; factory, loid and hwinfo are never touched.
+check_bootloader=\
+  itest $filesize == 40000 && itest.l *0x8220000c == 0x36353738 && \
+  crc32 0x82200000 0x1fffc 0x82400000 && \
+  setexpr.l blcrc *0x82400000 ^ ffffffff && itest.l *0x8221fffc == $blcrc && \
+  itest.l *0x82220000 == 0x27051956 && itest.l *0x82220010 == 0x81000000 && \
+  itest.b *0x8222001f == 3 && \
+  setexpr.l ubsize *0x8222000c && itest $ubsize <= 1ffc0 && \
+  crc32 0x82220040 $ubsize 0x82400000 && itest.l *0x82400000 == *0x82220018
+write_bootloader=\
+  mtd erase nor0 0 0x40000 && mtd write nor0 0x82200000 0 0x40000 && \
+  mtd read nor0 0x82300000 0 0x40000 && cmp.b 0x82200000 0x82300000 0x40000
+upgrade_uboot=\
+  tftpboot 0x82200000 $bootloaderfile && run check_bootloader && run write_bootloader
+
+# One-time move from the stock v1 layout. The stock factoryinfo (0x40000),
+# loid (0x50000) and hwinfo (0x60000) blocks already sit where OpenWrt
+# expects them, so nothing is merged or rewritten: only the boot area
+# (stock tcboot, romfile, bootflag) is replaced. The factoryinfo check also
+# stops a v2 board, whose 0x40000 holds loid, from taking this image.
+# Load the bootloader image to 0x82200000 first (tftpboot or loady).
+stock_factory_ok=itest.b *0x82000000 != 0xff && itest.w *0x820000aa == 0x0705 && itest.w *0x820000ac == 0x0701
+migrate_layout=\
+  run check_bootloader && \
+  mtd read nor0 0x82000000 0x40000 0x100 && run stock_factory_ok && \
+  run write_bootloader && echo Layout migrated, install OpenWrt with run install_openwrt
+
+preboot=run set_ethaddr
+# Hold reset at power-on to boot from TFTP.
+bootcmd=if button reset; then run boot_tftp; else run boot_openwrt; fi
+bootdelay=2
