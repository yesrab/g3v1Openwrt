. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

setup_interfaces()
{
  local board="$1"

  case "$board" in
  tplink,xz000-g3-v2)
    ucidef_set_interface "lan" device "lan pon0" protocol static \
      ipaddr 192.168.1.1
    ;;
  *)
    echo "Unsupported hardware. Network interfaces not initialized"
    ;;
  esac
}

board_config_update
board=$(board_name)
setup_interfaces $board
board_config_flush

exit 0
