From 5221a938b7dc972b13e32620bcf0ba911303af60 Mon Sep 17 00:00:00 2001
From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Date: Sun, 27 Sep 2026 03:31:56 +0530
Subject: [PATCH] net: airoha: fix non-constant mask in FIELD_PREP/FIELD_GET

930-316 (use common 80-byte FoE representation) replaced the old
per-field struct accessors (l2->vlan1, l2->etype, ...) with generic
word/mask/val helpers, airoha_foe_v1_l2_set() and
airoha_ppe_v1_debugfs_l2_get(), that forward their `mask` argument
straight into FIELD_PREP()/FIELD_GET(). Both macros require a
compile-time-constant mask (enforced via BUILD_BUG_ON_MSG on
__builtin_constant_p()), which only holds if the compiler actually
inlines the helper into each call site - every caller does pass a
literal AIROHA_FOE_L2_* mask, but as plain `static` functions there's
no guarantee GCC inlines them, and here it didn't:

  drivers/net/ethernet/airoha/airoha_ppe.c: In function 'airoha_foe_v1_l2_set':
  ./include/linux/bitfield.h:66: error: call to '__compiletime_assert_2924'
  declared with attribute error: FIELD_PREP: mask is not constant

Mark both helpers __always_inline so the mask is constant-folded at
each call site, matching how every other FIELD_PREP/FIELD_GET user in
this file is used directly at its callsite.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_ppe.c         | 5 +++--
 drivers/net/ethernet/airoha/airoha_ppe_debugfs.c | 5 +++--
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
index c48e070a7..3c78db8c5 100644
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -2606,8 +2606,9 @@ static u32 *airoha_foe_v1_l2(struct airoha_foe_entry *entry)
 	return &entry->words[airoha_foe_v1_l2_word(entry)];
 }
 
-static void airoha_foe_v1_l2_set(struct airoha_foe_entry *entry,
-				 unsigned int word, u32 mask, u32 val)
+static __always_inline void
+airoha_foe_v1_l2_set(struct airoha_foe_entry *entry,
+		     unsigned int word, u32 mask, u32 val)
 {
 	u32 *l2 = airoha_foe_v1_l2(entry);
 
diff --git a/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c b/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
index a44527504..4a9a437a0 100644
--- a/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
@@ -359,8 +359,9 @@ static int airoha_ppe_debugfs_foe_bind_show(struct seq_file *m, void *private)
 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_foe_bind);
 
 
-static u32 airoha_ppe_v1_debugfs_l2_get(const struct airoha_foe_entry *entry,
-				      unsigned int word, u32 mask)
+static __always_inline u32
+airoha_ppe_v1_debugfs_l2_get(const struct airoha_foe_entry *entry,
+			     unsigned int word, u32 mask)
 {
 	const u32 *l2 = &entry->words[airoha_foe_v1_l2_word(entry)];
 
-- 
