From d79ca7e27ed84f4735d4e6b0f1a466ce5767e116 Mon Sep 17 00:00:00 2001
From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Date: Mon, 28 Sep 2026 04:48:02 +0530
Subject: [PATCH] net: airoha: pass PLOAM retransmissions through the duplicate
 filter

The OLT sends each downstream PLOAM message three times in consecutive
frames, and ploam_filter_suppress() passes only the first copy of each
triple. It had no notion of time, so a retransmission the OLT sends
hundreds of milliseconds later, such as a repeated Configure_Port-ID
after a missing acknowledgement, was counted as part of the previous
triple and dropped. The OLT never received the acknowledgement and
deactivated the ONU.

Treat a message arriving more than 10 ms after the previous one as the
start of a new burst.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_ploam.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_ploam.c b/drivers/net/ethernet/airoha/airoha_ploam.c
index 451fa46d7..ea44f8b3c 100644
--- a/drivers/net/ethernet/airoha/airoha_ploam.c
+++ b/drivers/net/ethernet/airoha/airoha_ploam.c
@@ -51,6 +51,7 @@ struct ploam_priv {
 	struct ploam_msg	dedup_prev;
 	bool			dedup_prev_valid;
 	u32			dedup_same_cnt;
+	unsigned long		dedup_jiffies;
 };
 
 /* -----------------------------------------------------------------------
@@ -104,10 +105,16 @@ static bool ploam_filter_suppress(struct ploam_priv *pp,
 {
 	bool same;
 
-	if (!pp->dedup_prev_valid) {
+	/* Downstream PLOAM triples are transmitted in consecutive frames
+	 * (~125-250us apart). If a message arrives >10ms later, it belongs
+	 * to a new burst or retransmission and must not be suppressed.
+	 */
+	if (!pp->dedup_prev_valid ||
+	    time_after(jiffies, pp->dedup_jiffies + msecs_to_jiffies(10))) {
 		pp->dedup_prev       = *msg;
 		pp->dedup_prev_valid = true;
 		pp->dedup_same_cnt   = 1;
+		pp->dedup_jiffies    = jiffies;
 		return false;
 	}
 
@@ -125,6 +132,7 @@ static bool ploam_filter_suppress(struct ploam_priv *pp,
 	}
 
 	pp->dedup_prev = *msg;
+	pp->dedup_jiffies = jiffies;
 
 	if (!same) {
 		pp->dedup_same_cnt = 1;
@@ -132,7 +140,7 @@ static bool ploam_filter_suppress(struct ploam_priv *pp,
 	}
 
 	pp->dedup_same_cnt++;
-	/* Pass every 3rd (same_cnt==1,3,6,...), suppress 2nd and 3rd of each triple */
+	/* Pass 1st of burst, suppress consecutive duplicates in the same burst */
 	return (pp->dedup_same_cnt % 3) != 1;
 }
 
@@ -629,6 +637,7 @@ void ploam_reset(struct ploam_priv *pp)
 	pp->eqd                  = 0;
 	pp->dedup_prev_valid     = false;
 	pp->dedup_same_cnt       = 0;
+	pp->dedup_jiffies        = 0;
 	/* emergency_state is sticky: only cleared by Disable_SN PARTICIPATE */
 }
 
