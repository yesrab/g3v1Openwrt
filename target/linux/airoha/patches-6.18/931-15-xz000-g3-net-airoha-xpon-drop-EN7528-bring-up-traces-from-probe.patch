From a40c34fc258717e739a516eeff4db9c34a773867 Mon Sep 17 00:00:00 2001
From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Date: Tue, 29 Sep 2026 01:48:24 +0530
Subject: [PATCH] net: airoha: xpon: drop EN7528 bring-up traces from probe

The "EN7528 test:" prints around xPON provider, OAM handler and OMCI
registration were left over from EN7528 bring-up. They log every step
of a successful probe at info level, while failures already propagate
through the probe return code.

Remove them, and demote the xPON OAM RX counter dump, which fires on
every carrier change, to debug level.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c  | 20 ++++++++++----------
 drivers/net/ethernet/airoha/airoha_xpon.c | 11 -----------
 2 files changed, 10 insertions(+), 21 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 9ab011c06..2208c87e2 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -4463,16 +4463,16 @@ static void econet_xpon_dump_oam_rx_state(struct net_device *netdev)
 	if (econet_validate_xpon_gdm2(netdev, &port))
 		return;
 
-	netdev_info(netdev,
-		    "xPON OAM RX: packets=%lld bytes=%lld delivered=%lld dropped=%lld no-handler=%lld txchn=%#010x rxchn=%#010x hwf=%#010x\n",
-		    (long long)atomic64_read(&port->xpon_oam_rx_packets),
-		    (long long)atomic64_read(&port->xpon_oam_rx_bytes),
-		    (long long)atomic64_read(&port->xpon_oam_rx_delivered),
-		    (long long)atomic64_read(&port->xpon_oam_rx_dropped),
-		    (long long)atomic64_read(&port->xpon_oam_rx_no_handler),
-		    airoha_fe_rr(port->eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX)),
-		    airoha_fe_rr(port->eth, REG_GDM_RXCHN_EN(AIROHA_GDM2_IDX)),
-		    airoha_fe_rr(port->eth, REG_CDM_HWF_CHN_EN(2)));
+	netdev_dbg(netdev,
+		   "xPON OAM RX: packets=%lld bytes=%lld delivered=%lld dropped=%lld no-handler=%lld txchn=%#010x rxchn=%#010x hwf=%#010x\n",
+		   (long long)atomic64_read(&port->xpon_oam_rx_packets),
+		   (long long)atomic64_read(&port->xpon_oam_rx_bytes),
+		   (long long)atomic64_read(&port->xpon_oam_rx_delivered),
+		   (long long)atomic64_read(&port->xpon_oam_rx_dropped),
+		   (long long)atomic64_read(&port->xpon_oam_rx_no_handler),
+		   airoha_fe_rr(port->eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX)),
+		   airoha_fe_rr(port->eth, REG_GDM_RXCHN_EN(AIROHA_GDM2_IDX)),
+		   airoha_fe_rr(port->eth, REG_CDM_HWF_CHN_EN(2)));
 }
 
 static int econet_register_xpon_oam(struct net_device *netdev,
diff --git a/drivers/net/ethernet/airoha/airoha_xpon.c b/drivers/net/ethernet/airoha/airoha_xpon.c
index 37844c967..13d356867 100644
--- a/drivers/net/ethernet/airoha/airoha_xpon.c
+++ b/drivers/net/ethernet/airoha/airoha_xpon.c
@@ -4229,18 +4229,13 @@ static int airoha_xpon_register_gpon_omci(struct xpon_priv *priv)
 	priv->omci_handler.rx = airoha_gpon_omci_receive;
 	priv->omci_handler.priv = &priv->omci;
 
-	dev_info(priv->dev, "EN7528 test: registering xPON OAM handler\n");
 	ret = airoha_eth_register_xpon_oam(priv->gdm_dev,
 					   &priv->omci_handler);
-	dev_info(priv->dev, "EN7528 test: register xPON OAM returned %d\n",
-		 ret);
 	if (ret)
 		return ret;
 
-	dev_info(priv->dev, "EN7528 test: registering OMCI device\n");
 	ret = airoha_gpon_omci_register(&priv->omci, priv->xpon, priv->gdm_dev,
 					priv, &priv->identity);
-	dev_info(priv->dev, "EN7528 test: OMCI register returned %d\n", ret);
 	if (ret)
 		goto err_unregister_oam;
 
@@ -4249,9 +4244,7 @@ static int airoha_xpon_register_gpon_omci(struct xpon_priv *priv)
 	 * PLOAM state callback so userspace never observes an invalid O0.
 	 */
 	airoha_gpon_omci_set_state(&priv->omci, GPON_O1_INITIAL);
-	dev_info(priv->dev, "EN7528 test: starting OMCI transport\n");
 	ret = airoha_gpon_omci_start(&priv->omci);
-	dev_info(priv->dev, "EN7528 test: OMCI start returned %d\n", ret);
 	if (ret)
 		goto err_unregister_omci;
 
@@ -4458,12 +4451,8 @@ static int airoha_xpon_probe(struct platform_device *pdev)
 	}
 
 	link_ops = airoha_xpon_get_link_ops(priv);
-	dev_info(dev, "EN7528 test: registering Ethernet xPON provider on %s\n",
-		 priv->gdm_dev->name);
 	ret = airoha_eth_register_xpon(priv->gdm_dev, priv->mode, link_ops,
 				       priv);
-	dev_info(dev, "EN7528 test: Ethernet xPON registration returned %d\n",
-		 ret);
 	if (ret)
 		goto err_del_upstream;
 
-- 
2.43.0

