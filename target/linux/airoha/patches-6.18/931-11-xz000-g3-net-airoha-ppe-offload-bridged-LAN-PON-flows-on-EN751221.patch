 };
 
 struct airoha_ppe {
@@ -1198,6 +1208,8 @@ struct airoha_eth_soc_data {
 	int max_gdm_ports;
 	bool legacy_qdma;
 	bool ppe_datapath;
+	/* Offload bridged LAN/PON flows (FoE v1). */
+	bool ppe_bridge;
 	u32 pse_fq_cfg;
 	u32 ppe_stats_entries;
 	u32 ppe_sram_entries;
@@ -1405,6 +1417,11 @@ struct airoha_foe_entry *airoha_ppe_foe_get_entry(struct airoha_ppe *ppe,
 						  u32 hash);
 void airoha_ppe_foe_entry_get_stats(struct airoha_ppe *ppe, u32 hash,
 				    struct airoha_foe_stats64 *stats);
+void airoha_ppe_v1_bridge_learn_tx(struct airoha_eth *eth, struct sk_buff *skb,
+				   struct net_device *dev, bool xpon,
+				   u8 port_mask);
+void airoha_ppe_v1_bridge_flush_dev(struct net_device *netdev);
+void airoha_ppe_v1_restore_ingress(struct airoha_eth *eth);
 void airoha_ppe_v1_read_entry(struct airoha_ppe *ppe, u16 hash,
 			   struct airoha_foe_entry *entry);
 
diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
index 3c78db8c5..41f21198a 100644
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -10,11 +10,13 @@
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/rhashtable.h>
+#include <linux/rtnetlink.h>
 #include <net/ipv6.h>
 #include <net/flow_offload.h>
 #include <net/netlink.h>
 #include <net/pkt_cls.h>
 #include <net/route.h>
+#include <net/switchdev.h>
 #include <uapi/linux/ppp_defs.h>
 
 #include "airoha_regs.h"
@@ -2753,13 +2755,15 @@ static void airoha_foe_v1_entry_set_dsa(struct airoha_foe_entry *entry,
 
 	if (passthrough)
 		etype |= BIT(7);
-	if (!(entry->ib1 & AIROHA_FOE_V1_IB1_BIND_VLAN_LAYER))
+	/* With a VLAN already programmed, VLAN1 carries it in the special tag. */
+	if (!(entry->ib1 & AIROHA_FOE_V1_IB1_BIND_VLAN_LAYER)) {
 		entry->ib1 |= FIELD_PREP(AIROHA_FOE_V1_IB1_BIND_VLAN_LAYER, 1);
-	else
+		airoha_foe_v1_l2_set(entry, 0, AIROHA_FOE_L2_VLAN1, 0);
+	} else {
 		etype |= BIT(8);
+	}
 
 	airoha_foe_v1_l2_set(entry, 0, AIROHA_FOE_L2_ETYPE, etype);
-	airoha_foe_v1_l2_set(entry, 0, AIROHA_FOE_L2_VLAN1, 0);
 	entry->ib1 &= ~AIROHA_FOE_V1_IB1_BIND_VLAN_TAG;
 }
 
@@ -2803,9 +2807,9 @@ static void airoha_ppe_v1_commit_entry(struct airoha_ppe *ppe,
 	int i;
 
 	entry->ib1 &= ~AIROHA_FOE_IB1_BIND_TIMESTAMP;
+	/* TTL decrement comes from the prepared entry; bridged flows clear it. */
 	entry->ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_TIMESTAMP, timestamp) |
-		AIROHA_FOE_V1_IB1_BIND_CACHE | AIROHA_FOE_IB1_BIND_TTL |
-		AIROHA_FOE_IB1_BIND_KEEPALIVE;
+		AIROHA_FOE_V1_IB1_BIND_CACHE | AIROHA_FOE_IB1_BIND_KEEPALIVE;
 	airoha_foe_v1_entry_set_bind_metadata(entry);
 
 	if (lookup_raw) {
@@ -2983,10 +2987,24 @@ struct airoha_foe_v1_tuple {
 	};
 	u16 src_port;
 	u16 dest_port;
+	u8 l4proto;
+};
+
+/* Layer 2 of a received frame, as needed to rebuild it on a bridged path. */
+struct airoha_foe_v1_l2info {
+	u8 dmac[ETH_ALEN];
+	u8 smac[ETH_ALEN];
+	u16 vlan_proto;
+	u16 vlan_tci;
+	u16 pppoe_sid;
+	bool pppoe;
+	/* EN751221 GDM1 frames carry the switch special tag in band. */
+	bool mtk_tag;
 };
 
 static bool airoha_foe_v1_parse_tuple(struct sk_buff *skb,
-				   struct airoha_foe_v1_tuple *tuple)
+				   struct airoha_foe_v1_tuple *tuple,
+				   struct airoha_foe_v1_l2info *l2)
 {
 	const u8 *data = skb->data;
 	unsigned int len = skb->len;
@@ -2996,20 +3014,29 @@ static bool airoha_foe_v1_parse_tuple(struct sk_buff *skb,
 	if (len < ETH_HLEN)
 		return false;
 
+	memset(l2, 0, sizeof(*l2));
+	ether_addr_copy(l2->dmac, data);
+	ether_addr_copy(l2->smac, data + ETH_ALEN);
+
 	proto = get_unaligned_be16(data + proto_off);
-	if (proto == ETH_P_8021Q || proto == ETH_P_8021AD) {
-		if (len < ETH_HLEN + VLAN_HLEN)
-			return false;
-		proto_off += VLAN_HLEN;
-		proto = get_unaligned_be16(data + proto_off);
-	} else if (proto != ETH_P_IP && proto != ETH_P_IPV6 &&
-		   proto != ETH_P_PPP_SES) {
+	if (proto != ETH_P_IP && proto != ETH_P_IPV6 &&
+	    proto != ETH_P_PPP_SES && proto != ETH_P_8021Q &&
+	    proto != ETH_P_8021AD) {
 		/* MTK special tag occupies the ethertype/TCI position. */
-		if (len < ETH_HLEN + 4)
+		if (len < proto_off + 4 + sizeof(__be16))
 			return false;
+		l2->mtk_tag = true;
 		proto_off += 4;
 		proto = get_unaligned_be16(data + proto_off);
 	}
+	if (proto == ETH_P_8021Q || proto == ETH_P_8021AD) {
+		if (len < proto_off + VLAN_HLEN + sizeof(__be16))
+			return false;
+		l2->vlan_proto = proto;
+		l2->vlan_tci = get_unaligned_be16(data + proto_off + 2);
+		proto_off += VLAN_HLEN;
+		proto = get_unaligned_be16(data + proto_off);
+	}
 	off = proto_off + sizeof(__be16);
 
 	if (proto == ETH_P_PPP_SES) {
@@ -3017,6 +3044,8 @@ static bool airoha_foe_v1_parse_tuple(struct sk_buff *skb,
 
 		if (len < proto_off + 10)
 			return false;
+		l2->pppoe = true;
+		l2->pppoe_sid = get_unaligned_be16(data + proto_off + 4);
 		ppp_proto = get_unaligned_be16(data + proto_off + 8);
 		if (ppp_proto == PPP_IP)
 			proto = ETH_P_IP;
@@ -3044,6 +3073,7 @@ static bool airoha_foe_v1_parse_tuple(struct sk_buff *skb,
 
 		l4 = iph + ihl;
 		tuple->addr_type = FLOW_DISSECTOR_KEY_IPV4_ADDRS;
+		tuple->l4proto = iph[9];
 		tuple->v4.src = get_unaligned_be32(iph + offsetof(struct iphdr, saddr));
 		tuple->v4.dest = get_unaligned_be32(iph + offsetof(struct iphdr, daddr));
 		tuple->src_port = get_unaligned_be16(l4);
@@ -3066,6 +3096,7 @@ static bool airoha_foe_v1_parse_tuple(struct sk_buff *skb,
 			return false;
 
 		tuple->addr_type = FLOW_DISSECTOR_KEY_IPV6_ADDRS;
+		tuple->l4proto = nexthdr;
 		memcpy(&tuple->v6.src,
 		       data + off + offsetof(struct ipv6hdr, saddr),
 		       sizeof(tuple->v6.src));
@@ -3100,17 +3131,316 @@ airoha_foe_v1_flow_matches_tuple(const struct airoha_flow_table_entry *flow,
 	return false;
 }
 
+/*
+ * Bridged flows.  On a GPON bridge the PPE keys PPPoE/VLAN traffic on its
+ * inner IPv4 5-tuple like a routed flow, but no TC/flowtable rule exists
+ * for it.  An unbound frame is noted on RX, keyed by its PPE-derived
+ * skb->hash.  When the bridge transmits that frame on the other side of the
+ * LAN/PON boundary, a flow is created that rebuilds the frame's own layer 2
+ * on the new egress, and the next unbound RX of the tuple binds it through
+ * the normal v1 path.
+ */
+static unsigned long airoha_ppe_v1_flow_lastused(struct airoha_ppe *ppe,
+						 struct airoha_flow_table_entry *flow);
+
+#define AIROHA_PPE_V1_BRIDGE_PENDING	256
+#define AIROHA_PPE_V1_BRIDGE_MAX_FLOWS	1024
+#define AIROHA_PPE_V1_BRIDGE_IDLE	(30 * HZ)
+#define AIROHA_PPE_V1_BRIDGE_GC		(5 * HZ)
+
+struct airoha_ppe_v1_pending {
+	u32 rxhash;
+	unsigned long ts;
+	struct airoha_foe_v1_tuple tuple;
+	struct airoha_foe_v1_l2info l2;
+};
+
+static void airoha_ppe_v1_bridge_note_rx(struct airoha_ppe *ppe,
+					 struct sk_buff *skb,
+					 const struct airoha_foe_v1_tuple *tuple,
+					 const struct airoha_foe_v1_l2info *l2)
+{
+	struct airoha_ppe_v1_pending *p;
+
+	lockdep_assert_held(&ppe->v1.lock);
+	if (!READ_ONCE(ppe->v1.bridge) || !skb->l4_hash || !skb->hash ||
+	    (l2->vlan_proto && l2->vlan_proto != ETH_P_8021Q))
+		return;
+
+	p = &ppe->v1.pending[skb->hash % AIROHA_PPE_V1_BRIDGE_PENDING];
+	p->ts = jiffies;
+	p->tuple = *tuple;
+	p->l2 = *l2;
+	WRITE_ONCE(p->rxhash, skb->hash);
+}
+
+static bool
+airoha_ppe_v1_bridge_find_flow(struct airoha_ppe *ppe,
+			       const struct airoha_foe_v1_tuple *tuple)
+{
+	struct airoha_flow_table_entry *flow;
+
+	list_for_each_entry(flow, &ppe->v1.flows, v1_list)
+		if (airoha_foe_v1_flow_matches_tuple(flow, tuple))
+			return true;
+	return false;
+}
+
+static int airoha_ppe_v1_bridge_prepare(struct airoha_foe_entry *entry,
+					const struct airoha_ppe_v1_pending *p,
+					struct net_device *dev, bool xpon,
+					u8 port_mask)
+{
+	bool vlan = p->l2.vlan_proto == ETH_P_8021Q;
+	u16 vid = p->l2.vlan_tci & VLAN_VID_MASK;
+	u8 prio = (p->l2.vlan_tci & VLAN_PRIO_MASK) >> VLAN_PRIO_SHIFT;
+	__be16 sport = cpu_to_be16(p->tuple.src_port);
+	__be16 dport = cpu_to_be16(p->tuple.dest_port);
+	struct airoha_gdm_common *gdm;
+	int err;
+
+	/* Forward the frame as received: no NAT, no TTL/hop limit decrement. */
+	if (p->tuple.addr_type == FLOW_DISSECTOR_KEY_IPV4_ADDRS) {
+		__be32 src = cpu_to_be32(p->tuple.v4.src);
+		__be32 dest = cpu_to_be32(p->tuple.v4.dest);
+
+		airoha_foe_v1_entry_prepare(entry, p->tuple.l4proto,
+					    PPE_PKT_TYPE_IPV4_HNAPT,
+					    FE_PSE_PORT_GDM1,
+					    p->l2.smac, p->l2.dmac);
+		airoha_foe_v1_entry_set_ipv4_tuple(entry, false, src, sport,
+						   dest, dport);
+		airoha_foe_v1_entry_set_ipv4_tuple(entry, true, src, sport,
+						   dest, dport);
+	} else {
+		airoha_foe_v1_entry_prepare(entry, p->tuple.l4proto,
+					    PPE_PKT_TYPE_IPV6_ROUTE_5T,
+					    FE_PSE_PORT_GDM1,
+					    p->l2.smac, p->l2.dmac);
+		airoha_foe_v1_entry_set_ipv6_tuple(entry, &p->tuple.v6.src,
+						   sport, &p->tuple.v6.dest,
+						   dport);
+	}
+	entry->ib1 &= ~AIROHA_FOE_IB1_BIND_TTL;
+
+	if (vlan) {
+		err = airoha_foe_v1_entry_set_vlan(entry, vid, prio,
+						   htons(ETH_P_8021Q));
+		if (err)
+			return err;
+	}
+	if (p->l2.pppoe)
+		airoha_foe_v1_entry_set_pppoe(entry, p->l2.pppoe_sid);
+
+	if (xpon)
+		return airoha_foe_v1_entry_set_xpon(entry, dev, vlan, vid,
+						    vlan, prio);
+
+	gdm = airoha_gdm_common_from_netdev(dev);
+	if (!gdm || gdm->family != AIROHA_ETH_FAMILY_ECONET ||
+	    !is_power_of_2(port_mask))
+		return -EOPNOTSUPP;
+
+	airoha_foe_v1_entry_set_dsa(entry, __ffs(port_mask), false);
+	airoha_foe_v1_entry_set_pse_port(entry, gdm->pse_port);
+	return 0;
+}
+
+/*
+ * Called for every frame the EcoNet QDMA transmits.  @xpon is set for the
+ * GPON port, otherwise @port_mask is the destination of the in-band switch
+ * special tag.
+ */
+void airoha_ppe_v1_bridge_learn_tx(struct airoha_eth *eth, struct sk_buff *skb,
+				   struct net_device *dev, bool xpon,
+				   u8 port_mask)
+{
+	struct airoha_ppe *ppe = eth->ppe;
+	struct airoha_flow_table_entry *flow;
+	struct airoha_ppe_v1_pending *p, pend;
+	struct airoha_foe_entry entry;
+
+	if (!ppe || eth->soc->foe_format != AIROHA_FOE_FORMAT_V1 ||
+	    !READ_ONCE(ppe->v1.bridge) || !READ_ONCE(ppe->v1.armed) ||
+	    !skb->l4_hash || !skb->hash || skb_headlen(skb) < 2 * ETH_ALEN)
+		return;
+
+	p = &ppe->v1.pending[skb->hash % AIROHA_PPE_V1_BRIDGE_PENDING];
+	if (READ_ONCE(p->rxhash) != skb->hash)
+		return;
+
+	spin_lock_bh(&ppe->v1.lock);
+	/*
+	 * Only a frame crossing the LAN/PON boundary unchanged is bridged:
+	 * frames from the switch carry its special tag, frames from GDM2 do
+	 * not, and the addresses must be those seen on RX.
+	 */
+	if (p->rxhash != skb->hash || time_after(jiffies, p->ts + HZ) ||
+	    p->l2.mtk_tag != xpon ||
+	    memcmp(skb->data, p->l2.dmac, 2 * ETH_ALEN)) {
+		spin_unlock_bh(&ppe->v1.lock);
+		return;
+	}
+	pend = *p;
+	p->rxhash = 0;
+	if (ppe->v1.bridge_flows >= AIROHA_PPE_V1_BRIDGE_MAX_FLOWS ||
+	    airoha_ppe_v1_bridge_find_flow(ppe, &pend.tuple)) {
+		spin_unlock_bh(&ppe->v1.lock);
+		return;
+	}
+	spin_unlock_bh(&ppe->v1.lock);
+
+	if (airoha_ppe_v1_bridge_prepare(&entry, &pend, dev, xpon, port_mask))
+		return;
+
+	flow = kzalloc(sizeof(*flow), GFP_ATOMIC);
+	if (!flow)
+		return;
+
+	flow->data = entry;
+	flow->addr_type = pend.tuple.addr_type;
+	if (flow->addr_type == FLOW_DISSECTOR_KEY_IPV4_ADDRS) {
+		flow->src_ip = pend.tuple.v4.src;
+		flow->dest_ip = pend.tuple.v4.dest;
+	} else {
+		flow->src_ip6 = pend.tuple.v6.src;
+		flow->dest_ip6 = pend.tuple.v6.dest;
+	}
+	flow->src_port = pend.tuple.src_port;
+	flow->dest_port = pend.tuple.dest_port;
+	flow->hash = AIROHA_FOE_V1_INVALID_HASH;
+	flow->v1_lastused = jiffies;
+	flow->v1_bridge = true;
+
+	spin_lock_bh(&ppe->v1.lock);
+	if (ppe->v1.bridge_flows >= AIROHA_PPE_V1_BRIDGE_MAX_FLOWS ||
+	    airoha_ppe_v1_bridge_find_flow(ppe, &pend.tuple)) {
+		spin_unlock_bh(&ppe->v1.lock);
+		kfree(flow);
+		return;
+	}
+	list_add_tail(&flow->v1_list, &ppe->v1.flows);
+	ppe->v1.bridge_flows++;
+	spin_unlock_bh(&ppe->v1.lock);
+}
