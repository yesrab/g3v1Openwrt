+static bool airoha_ppe_v1_flow_has_addr(struct airoha_flow_table_entry *flow,
+					const u8 *addr)
+{
+	const u32 *l2 = airoha_foe_v1_l2(&flow->data);
+	u32 hi = get_unaligned_be32(addr);
+	u16 lo = get_unaligned_be16(addr + 4);
+
+	return (l2[1] == hi &&
+		FIELD_GET(AIROHA_FOE_L2_DMAC_LO, l2[2]) == lo) ||
+	       (l2[3] == hi &&
+		FIELD_GET(AIROHA_FOE_L2_SMAC_LO, l2[4]) == lo);
+}
+
+/*
+ * Drop bridged flows: only idle ones (@idle), those from or to @addr, or
+ * all of them.  Hardware entries are invalidated before the flows go away,
+ * so a stale binding never forwards with outdated layer 2 or GEM mapping.
+ */
+static void airoha_ppe_v1_bridge_expire(struct airoha_ppe *ppe,
+					const u8 *addr, bool idle)
+{
+	struct airoha_flow_table_entry *flow, *tmp;
+	LIST_HEAD(free_list);
+	bool clean = false;
+
+	spin_lock_bh(&ppe->v1.lock);
+	list_for_each_entry_safe(flow, tmp, &ppe->v1.flows, v1_list) {
+		if (!flow->v1_bridge)
+			continue;
+		if (addr && !airoha_ppe_v1_flow_has_addr(flow, addr))
+			continue;
+		if (idle &&
+		    time_before(jiffies, airoha_ppe_v1_flow_lastused(ppe, flow) +
+					  AIROHA_PPE_V1_BRIDGE_IDLE))
+			continue;
+
+		clean |= flow->hash != AIROHA_FOE_V1_INVALID_HASH;
+		airoha_ppe_v1_release_flow_slot(ppe, flow, true);
+		list_move(&flow->v1_list, &free_list);
+		ppe->v1.bridge_flows--;
+	}
+	if (clean)
+		airoha_ppe_v1_cache_clean(ppe);
+	spin_unlock_bh(&ppe->v1.lock);
+
+	list_for_each_entry_safe(flow, tmp, &free_list, v1_list)
+		kfree(flow);
+}
+
+static void airoha_ppe_v1_bridge_flush(struct airoha_ppe *ppe)
+{
+	if (READ_ONCE(ppe->v1.bridge_flows))
+		airoha_ppe_v1_bridge_expire(ppe, NULL, false);
+}
+
+static void airoha_ppe_v1_bridge_gc(struct work_struct *work)
+{
+	struct airoha_ppe *ppe = container_of(to_delayed_work(work),
+					      struct airoha_ppe, v1.bridge_gc);
+
+	airoha_ppe_v1_bridge_expire(ppe, NULL, true);
+	if (READ_ONCE(ppe->v1.bridge))
+		schedule_delayed_work(&ppe->v1.bridge_gc,
+				      AIROHA_PPE_V1_BRIDGE_GC);
+}
