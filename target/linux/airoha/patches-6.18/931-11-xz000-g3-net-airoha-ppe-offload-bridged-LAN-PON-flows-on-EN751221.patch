+/* Callers serialize through RTNL, or run before the netdevs exist. */
+static int airoha_ppe_v1_bridge_set(struct airoha_ppe *ppe, bool enable)
+{
+	int err;
+
+	if (enable == READ_ONCE(ppe->v1.bridge))
+		return 0;
+
+	if (enable) {
+		err = airoha_ppe_v1_engine_arm(ppe);
+		if (err)
+			return err;
+		WRITE_ONCE(ppe->v1.bridge, true);
+		schedule_delayed_work(&ppe->v1.bridge_gc,
+				      AIROHA_PPE_V1_BRIDGE_GC);
+		return 0;
+	}
+
+	WRITE_ONCE(ppe->v1.bridge, false);
+	cancel_delayed_work_sync(&ppe->v1.bridge_gc);
+	airoha_ppe_v1_bridge_flush(ppe);
+	if (!airoha_ppe_v1_keep_armed(ppe))
+		airoha_ppe_v1_engine_disarm(ppe);
+	return 0;
+}
