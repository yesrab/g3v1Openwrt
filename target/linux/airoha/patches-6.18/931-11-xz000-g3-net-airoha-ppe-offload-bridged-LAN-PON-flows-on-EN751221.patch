From 443039186cbc53c41500a29521b7287050dbeb71 Mon Sep 17 00:00:00 2001
From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Date: Mon, 28 Sep 2026 23:53:47 +0530
Subject: [PATCH] net: airoha: ppe: offload bridged LAN/PON flows on EN751221

On a GPON bridge no TC/flowtable rule describes the traffic, so the
EN751221 PPE reports every flow as HIT_UNBIND and the CPU bridges all of
it; on the TP-Link XZ000-G3 v2 that caps a 300 Mbps line at ~180 Mbps
with the CPU saturated. The PPE keys PPPoE/VLAN frames on their inner
IPv4/IPv6 5-tuple, like a routed flow.

Learn those flows in the driver, the way the vendor hw_nat does:

- note unbound frames on RX, keyed by the PPE-derived skb hash;
- when the bridge transmits the same frame across the LAN/PON boundary,
  create a v1 flow that rebuilds the frame's own layer 2 on the new
  egress: VLAN, PPPoE session and GEM/T-CONT towards the PON, the switch
  special tag towards the LAN, without NAT or TTL/hop limit decrement;
- bind it on the next unbound RX through the existing v1 path.

Bindings must never outlive what they encode, so bridged flows are
invalidated when idle for 30 s, on PPPoE PADS/PADT, on GPON link,
service, T-CONT and datapath changes, on netdev down/carrier/upper
changes, and per address on bridge FDB learn/move/age events.

Arm the PPE and enable this at probe on EN751221, reassert the PPE
ingress after GDM initialization, keep the engine armed while bridged
offload is on, and expose the ppe_bridge device attribute to turn it
off at runtime.

Keep VLAN1 in the special tag when a VLAN layer is already programmed,
as the MediaTek FoE does, and accept an MTK special tag followed by an
802.1Q header when parsing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c |  39 +-
 drivers/net/ethernet/airoha/airoha_eth.h |  17 +
 drivers/net/ethernet/airoha/airoha_ppe.c | 559 ++++++++++++++++++++++-
 3 files changed, 582 insertions(+), 33 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index ad89b9d1b..9ab011c06 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -3939,7 +3939,7 @@ static int econet_xpon_classify(struct airoha_gdm_dev *port,
 static netdev_tx_t econet_qdma_xmit(struct sk_buff *skb, struct net_device *dev)
 {
 	struct airoha_gdm_dev *port = netdev_priv(dev);
-	struct airoha_qdma_skb_meta skb_meta;
+	struct airoha_qdma_skb_meta skb_meta = {};
 	int qid, ret = 0, len = skb->len;
 	struct netdev_queue *txq;
 	struct airoha_xpon_tx_info xpon_info;
@@ -4038,6 +4038,11 @@ static netdev_tx_t econet_qdma_xmit(struct sk_buff *skb, struct net_device *dev)
 
 	set_etx_channel(&msg.etx, channel);
 
+	if (xpon ? READ_ONCE(port->xpon_mode) == AIROHA_XPON_MODE_GPON :
+		   skb_meta.has_mtk_tag)
+		airoha_ppe_v1_bridge_learn_tx(port->eth, skb, dev, xpon,
+					      xpon ? 0 : skb_meta.port_mask);
+
 	/*
 	 * EN751221 QDMA can generate IPv4/IPv6 TCP and UDP checksums.
 	 * The vendor driver programs all parser checksum-offload bits for a
@@ -6988,6 +6993,7 @@ static int airoha_dev_init(struct net_device *netdev)
 		cpu_fport = dev->fport == ETX_FPORT_GDM2 ?
 			    ETX_FPORT_QDMA1_CPU : ETX_FPORT_QDMA0_CPU;
 		econet_set_gdm_port_fwd_cfg(dev, cpu_fport);
+		airoha_ppe_v1_restore_ingress(dev->eth);
 
 		if (dev->fport == ETX_FPORT_GDM1) {
 			struct g1_cport_cfg cport_cfg;
@@ -9683,6 +9689,7 @@ const struct airoha_eth_soc_data econet_en751221_soc_data = {
 	.pse_fq_cfg = PSE_FQ_CFG,
 	.ppe_dram_entries = 16 * 1024,
 	.foe_format = AIROHA_FOE_FORMAT_V1,
+	.ppe_bridge = true,
 	.ppe_fport = EN751221_GDM_FPORT_PPE,
 	.ppe_cpu_fport = {
 		EN751221_GDM_FPORT_QDMA0_CPU,
@@ -10044,9 +10051,12 @@ int airoha_eth_set_xpon_datapath(struct net_device *netdev,
 				 enum airoha_xpon_mode mode, bool enable)
 {
 	const struct airoha_eth_xpon_ops *ops = airoha_eth_get_xpon_ops(netdev, NULL);
+	int ret;
 
-	return ops && ops->set_datapath ?
-		ops->set_datapath(netdev, mode, enable) : -EOPNOTSUPP;
+	ret = ops && ops->set_datapath ?
+	      ops->set_datapath(netdev, mode, enable) : -EOPNOTSUPP;
+	airoha_ppe_v1_bridge_flush_dev(netdev);
+	return ret;
 }
 EXPORT_SYMBOL_GPL(airoha_eth_set_xpon_datapath);
 
@@ -10054,9 +10064,12 @@ int airoha_eth_set_xpon_tcont_channel(struct net_device *netdev,
 				      unsigned int channel, bool enable)
 {
 	const struct airoha_eth_xpon_ops *ops = airoha_eth_get_xpon_ops(netdev, NULL);
+	int ret;
 
-	return ops && ops->set_tcont_channel ?
-		ops->set_tcont_channel(netdev, channel, enable) : -EOPNOTSUPP;
+	ret = ops && ops->set_tcont_channel ?
+	      ops->set_tcont_channel(netdev, channel, enable) : -EOPNOTSUPP;
+	airoha_ppe_v1_bridge_flush_dev(netdev);
+	return ret;
 }
 EXPORT_SYMBOL_GPL(airoha_eth_set_xpon_tcont_channel);
 
@@ -10090,6 +10103,7 @@ void airoha_eth_xpon_update_link(struct net_device *netdev,
 
 	if (ops && ops->update_link)
 		ops->update_link(netdev, state);
+	airoha_ppe_v1_bridge_flush_dev(netdev);
 }
 EXPORT_SYMBOL_GPL(airoha_eth_xpon_update_link);
 
@@ -10153,9 +10167,12 @@ int airoha_eth_xpon_add_service(struct net_device *netdev,
 				const struct airoha_xpon_service_cfg *cfg)
 {
 	const struct airoha_eth_xpon_ops *ops = airoha_eth_get_xpon_ops(netdev, NULL);
+	int ret;
 
-	return ops && ops->add_service ?
-		ops->add_service(netdev, cfg) : -EOPNOTSUPP;
+	ret = ops && ops->add_service ? ops->add_service(netdev, cfg) :
+	      -EOPNOTSUPP;
+	airoha_ppe_v1_bridge_flush_dev(netdev);
+	return ret;
 }
 EXPORT_SYMBOL_GPL(airoha_eth_xpon_add_service);
 
@@ -10174,9 +10191,12 @@ bool airoha_eth_xpon_del_service(struct net_device *netdev, u32 cookie,
 				 u16 *gem_port_id)
 {
 	const struct airoha_eth_xpon_ops *ops = airoha_eth_get_xpon_ops(netdev, NULL);
+	bool ret;
 
-	return ops && ops->del_service ?
-		ops->del_service(netdev, cookie, gem_port_id) : false;
+	ret = ops && ops->del_service ?
+	      ops->del_service(netdev, cookie, gem_port_id) : false;
+	airoha_ppe_v1_bridge_flush_dev(netdev);
+	return ret;
 }
 EXPORT_SYMBOL_GPL(airoha_eth_xpon_del_service);
 
@@ -10195,6 +10215,7 @@ void airoha_eth_xpon_flush_services(struct net_device *netdev)
 
 	if (ops && ops->flush_services)
 		ops->flush_services(netdev);
+	airoha_ppe_v1_bridge_flush_dev(netdev);
 }
 EXPORT_SYMBOL_GPL(airoha_eth_xpon_flush_services);
 
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
index ba0574940..14c6b38bf 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -790,6 +790,8 @@ struct airoha_flow_table_entry {
 	struct list_head v1_list;
 	/* v1: last real activity (RX bind or hardware BIND timestamp). */
 	unsigned long v1_lastused;
+	/* v1: learned from bridged traffic, not owned by a TC rule. */
+	bool v1_bridge;
 	u16 addr_type;
 	u16 src_port;
 	u16 dest_port;
@@ -1109,6 +1111,14 @@ struct airoha_ppe_v1 {
 	struct airoha_flow_table_entry **foe_owner;
