+static void airoha_ppe_v1_bridge_init(struct airoha_ppe *ppe)
+{
+	struct device *dev = ppe->common.eth->dev;
+	int err;
+
+	ppe->v1.netdev_nb.notifier_call = airoha_ppe_v1_netdev_event;
+	ppe->v1.switchdev_nb.notifier_call = airoha_ppe_v1_switchdev_event;
+	if (register_netdevice_notifier(&ppe->v1.netdev_nb))
+		ppe->v1.netdev_nb.notifier_call = NULL;
+	if (register_switchdev_notifier(&ppe->v1.switchdev_nb))
+		ppe->v1.switchdev_nb.notifier_call = NULL;
+	if (!ppe->v1.netdev_nb.notifier_call ||
+	    !ppe->v1.switchdev_nb.notifier_call) {
+		/* Without invalidation a stale binding could outlive a move. */
+		dev_warn(dev, "no bridge event notifiers, bridge offload disabled\n");
+		return;
+	}
+
+	if (device_create_file(dev, &dev_attr_ppe_bridge))
+		dev_warn(dev, "failed to create ppe_bridge attribute\n");
+
+	err = airoha_ppe_v1_bridge_set(ppe, true);
+	if (err)
+		dev_warn(dev, "bridge offload not enabled: %d\n", err);
+	else
+		dev_info(dev, "PPE offload of bridged flows enabled\n");
