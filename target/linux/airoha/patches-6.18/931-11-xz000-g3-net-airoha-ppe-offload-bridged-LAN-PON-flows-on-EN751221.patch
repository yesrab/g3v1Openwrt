+/*
+ * Topology changes: a port going down, leaving or joining a bridge, or a
+ * carrier change (the GPON link included) invalidates every bridged flow.
+ */
+static int airoha_ppe_v1_netdev_event(struct notifier_block *nb,
+				      unsigned long event, void *ptr)
+{
+	struct airoha_ppe *ppe = container_of(nb, struct airoha_ppe,
+					      v1.netdev_nb);
+
+	switch (event) {
+	case NETDEV_DOWN:
+	case NETDEV_CHANGE:
+	case NETDEV_CHANGEUPPER:
+	case NETDEV_CHANGEADDR:
+		airoha_ppe_v1_bridge_flush(ppe);
+		break;
+	}
+	return NOTIFY_DONE;
+}
+
+/*
+ * A station learned, moved or aged out in a bridge FDB: drop the flows
+ * from or to that address, like the vendor clean-by-MAC hooks.
+ */
+static int airoha_ppe_v1_switchdev_event(struct notifier_block *nb,
+					 unsigned long event, void *ptr)
+{
+	struct airoha_ppe *ppe = container_of(nb, struct airoha_ppe,
+					      v1.switchdev_nb);
+	struct switchdev_notifier_fdb_info *fdb;
+
+	if (event != SWITCHDEV_FDB_ADD_TO_DEVICE &&
+	    event != SWITCHDEV_FDB_DEL_TO_DEVICE)
+		return NOTIFY_DONE;
+
+	fdb = container_of(ptr, struct switchdev_notifier_fdb_info, info);
+	if (READ_ONCE(ppe->v1.bridge_flows))
+		airoha_ppe_v1_bridge_expire(ppe, fdb->addr, false);
+	return NOTIFY_DONE;
+}
