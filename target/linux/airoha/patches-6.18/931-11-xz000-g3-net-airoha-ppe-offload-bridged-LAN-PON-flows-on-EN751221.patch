+/* PPPoE PADS/PADT: a bound flow would keep rewriting the old session ID. */
+#define AIROHA_PPPOE_CODE_PADS		0x65
+#define AIROHA_PPPOE_CODE_PADT		0xa7
+
+static bool airoha_foe_v1_pppoe_session_change(const struct sk_buff *skb)
+{
+	unsigned int len = skb_headlen(skb), off = 12;
+	const u8 *data = skb->data;
+	u16 proto;
+
+	if (len < ETH_HLEN)
+		return false;
+
+	proto = get_unaligned_be16(data + off);
+	if (proto != ETH_P_PPP_DISC && proto != ETH_P_8021Q &&
+	    proto != ETH_P_8021AD) {
+		/* MTK special tag */
+		off += 4;
+		if (len < off + sizeof(__be16))
+			return false;
+		proto = get_unaligned_be16(data + off);
+	}
+	if (proto == ETH_P_8021Q || proto == ETH_P_8021AD) {
+		off += VLAN_HLEN;
+		if (len < off + sizeof(__be16))
+			return false;
+		proto = get_unaligned_be16(data + off);
+	}
+
+	/* ethertype, ver/type, code */
+	return proto == ETH_P_PPP_DISC && len > off + 3 &&
+	       (data[off + 3] == AIROHA_PPPOE_CODE_PADS ||
+		data[off + 3] == AIROHA_PPPOE_CODE_PADT);
+}
