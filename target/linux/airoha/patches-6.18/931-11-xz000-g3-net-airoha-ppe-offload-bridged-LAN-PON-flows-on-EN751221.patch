+static bool airoha_ppe_v1_keep_armed(struct airoha_ppe *ppe)
+{
+	return !list_empty(&ppe->block_cb_list) ||
+	       ppe->common.eth->soc->ppe_datapath ||
+	       READ_ONCE(ppe->v1.bridge);
