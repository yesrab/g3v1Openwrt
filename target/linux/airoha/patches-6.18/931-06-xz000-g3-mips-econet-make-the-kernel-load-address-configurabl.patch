From ef1595b5a430f4287d7b352bffc49880d31f01a8 Mon Sep 17 00:00:00 2001
From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Date: Sun, 27 Sep 2026 17:14:36 +0530
Subject: [PATCH] mips: econet: make the kernel load address configurable

The kernel is linked at 0x82000000 and booted through zboot so that it
stays clear of the SDK bootloader's 7.2 MB unpack limit. Small kernels
fit in that area, and for them the zboot stage only adds a second
compression pass on top of the bootloader's LZMA. Let such boards link
the kernel where the bootloader unpacks it.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/mips/econet/Kconfig  | 11 +++++++++++
 arch/mips/econet/Platform |  8 +++-----
 2 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/arch/mips/econet/Kconfig b/arch/mips/econet/Kconfig
index c40cc851f..1ec2f0b23 100644
--- a/arch/mips/econet/Kconfig
+++ b/arch/mips/econet/Kconfig
@@ -65,6 +65,17 @@ choice
 		  Requires MIPS_RAW_APPENDED_DTB=y for boot.
 endchoice
 
+config ECONET_LOAD_ADDRESS
+	hex "Kernel load address"
+	default 0xffffffff82000000
+	help
+	  The EcoNet SDK bootloader cannot unpack kernels larger than about
+	  7.2 MB, so by default the kernel is linked above that area and
+	  booted through zboot. A kernel that fits can be linked where the
+	  bootloader unpacks it (0xffffffff80020000) and booted without
+	  zboot, which avoids compressing it twice. ZBOOT_LOAD_ADDRESS must
+	  then point above the kernel.
+
 choice
 	prompt "Devicetree selection"
 	default DTB_ECONET_NONE
diff --git a/arch/mips/econet/Platform b/arch/mips/econet/Platform
index a4212d9c0..ef375a2fc 100644
--- a/arch/mips/econet/Platform
+++ b/arch/mips/econet/Platform
@@ -1,5 +1,3 @@
-# To address a 7.2MB kernel size limit in the EcoNet SDK bootloader,
-# we put the load address well above where the bootloader loads and then use
-# zboot. So please set CONFIG_ZBOOT_LOAD_ADDRESS to the address where your
-# bootloader actually places the kernel.
-load-$(CONFIG_ECONET)	+= 0xffffffff82000000
+# See ECONET_LOAD_ADDRESS for why the default sits above the bootloader's
+# 7.2MB unpack area.
+load-$(CONFIG_ECONET)	+= $(CONFIG_ECONET_LOAD_ADDRESS)
-- 
2.43.0

